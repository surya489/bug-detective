{
  "name": "bug-detective",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @bug-detective/web",
    "build": "npm run build --workspace @bug-detective/web",
    "start": "npm run start --workspace @bug-detective/web",
    "lint": "eslint apps/web",
    "test:web": "node --require ./apps/web/tests/register-typescript.cjs --test ./apps/web/tests/github.test.cjs ./apps/web/tests/pagination.test.cjs ./apps/web/tests/commit-diff.test.cjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.17"
  }
}