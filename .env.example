# GitHub App user authorization (server-side only)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/github/callback

# Generate 32 random bytes and encode as base64url; never commit the generated value.
GITHUB_SESSION_SECRET=

# Analyzer service URL
ANALYZER_URL=http://127.0.0.1:8001

# Analyzer resource limits (service process environment)
ANALYZER_MAX_FILES=10000
ANALYZER_MAX_FILE_BYTES=1048576
ANALYZER_MAX_TOTAL_BYTES=52428800
ANALYZER_MAX_SCAN_SECONDS=300
ANALYZER_MAX_ANALYZER_SECONDS=30
ANALYZER_MAX_ENTRIES=50000
ANALYZER_MAX_FINDINGS=1000

# Optional AI provider credentials
AI_PROVIDER_API_KEY=
